# Cabeceras para hosts estáticos que leen este archivo (Netlify, Cloudflare Pages).
# Para Vercel, lo mismo está en vercel.json.

# Los assets que Vite emite llevan hash en el nombre: cambiar el contenido cambia
# la URL, así que se pueden cachear para siempre sin riesgo de servir algo viejo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Las fotos no llevan hash, pero solo cambian cuando cambia el catálogo. Un mes
# de caché con revalidación evita volver a bajar 20 kB por tarjeta en cada visita.
/products/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Las fuentes llevan la versión en el nombre (manrope-v20-700-latin.woff2), así
# que una revisión de la fuente cambia la URL: se pueden marcar inmutables.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML se revalida siempre: es lo que permite publicar un cambio de precio o
# de política y que se vea al instante.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Cabeceras de seguridad.
#
# La CSP NO está aquí: la escribe `npm run build:ssg` en un <meta> de cada
# página, deducida de la configuración (ver src/lib/csp.js). Así conoce qué
# hosts hay conectados de verdad y vale igual en cualquier host, incluso
# arrastrando `dist/` a Netlify Drop. Duplicarla aquí solo crearía dos versiones
# que se separan.
#
# `X-Frame-Options` sí tiene que ir en cabecera: `frame-ancestors` no se admite
# en <meta>, y esta es la única forma de impedir que embeban el sitio.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
