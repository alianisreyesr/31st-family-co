# Copia este archivo a `.env` y rellena lo que tengas disponible.
# Todo es opcional: la app degrada con elegancia cuando falta una variable.

# URL publica del sitio. Se usa para las etiquetas canonical, Open Graph,
# el sitemap y el JSON-LD. Sin barra final.
VITE_SITE_URL=https://31stfamilyco.com

# --- Captura de emails -------------------------------------------------------
# Endpoint que recibe un POST con { email, source }.
# Sirve cualquiera de estos: Formspree (https://formspree.io/f/XXXXXXXX),
# una Netlify/Vercel function propia, Brevo, Klaviyo o Mailchimp via proxy.
# Si esta vacio, el formulario avisa que la lista no esta conectada en vez de
# mentirle a la persona diciendo que ya esta dentro.
VITE_NEWSLETTER_ENDPOINT=

# --- Compra ------------------------------------------------------------------
# Tienda o checkout general (Shopify, Stripe Payment Link, etc.).
VITE_CHECKOUT_URL=

# Numero de WhatsApp en formato internacional sin signos, ej. 17875551234.
# Se usa como fallback para pedidos cuando no hay checkout configurado.
VITE_WHATSAPP_NUMBER=

# --- Redes y contacto --------------------------------------------------------
# Los valores por defecto en `src/lib/config.js` son los publicados en
# 31stfamilyco.com; solo hace falta rellenar aqui lo que quieras cambiar.

# Perfil de Instagram. Ultimo fallback para pedidos por DM.
VITE_INSTAGRAM_URL=https://www.instagram.com/31stfamilyco/
VITE_TIKTOK_URL=https://www.tiktok.com/@31stfamilyco
VITE_FACEBOOK_URL=

# Email de contacto que aparece en el footer y en las paginas legales.
# Recomendacion: mover a un correo del dominio (hola@31stfamilyco.com) en vez
# de la cuenta de Gmail que se usa hoy.
VITE_CONTACT_EMAIL=31stfamilyco@gmail.com

# --- Analitica ---------------------------------------------------------------
# Dominio registrado en Plausible. Si esta vacio no se carga ningun script
# de terceros y no se envia ningun evento.
VITE_PLAUSIBLE_DOMAIN=
# Host propio si usas Plausible self-hosted o un proxy.
VITE_PLAUSIBLE_HOST=https://plausible.io
